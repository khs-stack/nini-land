# 운영 배포(Vercel 등)에서는 아래 값을 설정하지 않거나 반드시 false로 둡니다.
# 값이 없으면 자동으로 꺼진 상태(false)로 동작합니다 (fail-closed).
#
# true로 켜면 로그인 없이도 헤더의 ☰ 버튼으로 게스트/일반회원/승인대기/도매회원/관리자
# 역할을 자유롭게 전환할 수 있고, 로그인/회원가입 폼에 테스트용 계정이 미리 채워집니다.
# 실사이트 방문자가 이 기능으로 관리자 권한을 얻을 수 있으므로 운영에서는 절대 켜면 안 됩니다.
NEXT_PUBLIC_ENABLE_DEMO_ROLES=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# 홈 화면 등에 노출되는 임시/예시성 프로모션 문구를 쓸지 여부.
NEXT_PUBLIC_ENABLE_DEMO_PROMOTIONS=false

# Supabase (니니랜드 DB). 공개용 publishable 키만 넣는다. service_role 키는 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
